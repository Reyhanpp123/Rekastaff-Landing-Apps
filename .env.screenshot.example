# Salin ke .env.screenshot (file itu di-gitignore) lalu isi.
# Pakai akun DEV tenant testing dengan data dummy. Jangan akun produksi:
# screenshot dipublikasikan di landing page.
SCREENSHOT_EMAIL=
SCREENSHOT_PASSWORD=

# URL dashboard yang sedang berjalan (default: http://localhost:3001)
SCREENSHOT_DASHBOARD_URL=http://localhost:3001
